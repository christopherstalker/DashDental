APP_PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dental_recovery
# Production Neon example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=verify-full
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

OAUTH_ISSUER_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/auth/oidc/callback

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# Billing launch path. Use manual for the first clinic. Stripe checkout is a
# deferred backend path and should stay empty unless BILLING_PROVIDER=stripe or
# an explicit Stripe hybrid rehearsal is approved.
BILLING_PROVIDER=manual
MANUAL_BILLING_RECIPIENT_NAME=
MANUAL_BILLING_RECIPIENT_ADDRESS=
MANUAL_BILLING_IBAN=
MANUAL_BILLING_SWIFT_BIC=
MANUAL_BILLING_BANK_NAME=
MANUAL_BILLING_BANK_ADDRESS=
MANUAL_BILLING_CURRENCY=USD
MANUAL_BILLING_SUPPORT_EMAIL=support@dashdental.space
MANUAL_BILLING_INVOICE_PREFIX=DR

INTEGRATION_SECRET=replace-me
WEBHOOK_SIGNING_SECRET=

# Public app edge controls are enforced at the frontend/CDN layer. Keep these
# mirrored here so platform operators see the same launch contract.
REQUIRE_PUBLIC_AUTH_BOT_PROTECTION=false
TURNSTILE_SECRET_KEY=
EDGE_RATE_LIMIT_PROFILE=launch
EDGE_PROTECTION_DEPLOYED=false
SUPPORT_OWNER_NAME=
SUPPORT_OWNER_EMAIL=support@dashdental.space
SECURITY_CONTACT_EMAIL=security@dashdental.space
INCIDENT_ESCALATION_EMAIL=incidents@dashdental.space
SYNTHETIC_MONITOR_BASE_URL=
SYNTHETIC_MONITOR_SCHEDULED=false
PRODUCTION_MONITOR_POLICY_APPROVED=false
LEGAL_REVIEW_APPROVED=false
DPA_APPROVED=false
SUBPROCESSORS_APPROVED=false
ORDER_FORM_APPROVED=false
CANCELLATION_POLICY_APPROVED=false
DATA_HANDLING_POLICY_APPROVED=false
FIRST_CLINIC_REHEARSAL_APPROVED=false
DATABASE_BACKUPS_CONFIRMED=false
MANUAL_INVOICE_TEMPLATE_APPROVED=false
