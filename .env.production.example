# Dash Dental production environment example.
# Safe placeholder values only. Do not commit real production secrets.

# Public app origin. Required for OAuth, Stripe redirects, webhook registration,
# synthetic monitoring, and absolute links. Must be HTTPS and not localhost.
APP_URL="https://dashdental.space"

# Storage/runtime. Production must use managed Postgres and Redis.
APP_STORAGE_DRIVER="prisma"
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=verify-full"
REDIS_URL="redis://default:PASSWORD@HOST:6379"

# Server-only signing/encryption secrets. Generate unique 32+ character values.
SESSION_SECRET="replace-with-32-plus-character-production-session-secret"
JWT_ACCESS_SECRET="replace-with-32-plus-character-production-access-secret"
JWT_REFRESH_SECRET="replace-with-32-plus-character-production-refresh-secret"
INTEGRATION_SECRET="replace-with-32-plus-character-production-integration-secret"

# Email delivery for clinic team invitation setup links.
RESEND_API_KEY="re_replace_with_resend_api_key"
EMAIL_FROM="Dash Dental <noreply@dashdental.space>"

# Public auth abuse protection. Site key is public; secret key is server-only.
REQUIRE_PUBLIC_AUTH_BOT_PROTECTION="true"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x-production-site-key"
TURNSTILE_SECRET_KEY="0x-production-secret-key"

# Production must not expose development shortcuts.
ENABLE_DEV_LOGIN="false"
ENABLE_DEMO_ACTIONS="false"
ENABLE_DEV_BILLING="false"

# Edge protection and production operations gates.
EDGE_RATE_LIMIT_PROFILE="launch"
EDGE_PROTECTION_DEPLOYED="false"
DATABASE_BACKUPS_CONFIRMED="false"
SYNTHETIC_MONITOR_BASE_URL="https://dashdental.space"
SYNTHETIC_MONITOR_SCHEDULED="false"
PRODUCTION_MONITOR_POLICY_APPROVED="false"
SYNTHETIC_MONITOR_ALLOW_PRODUCTION="false"

# Public support contacts. Routing must be verified externally before launch.
SUPPORT_OWNER_NAME="Launch support owner"
SUPPORT_OWNER_EMAIL="support@dashdental.space"
SECURITY_CONTACT_EMAIL="security@dashdental.space"
INCIDENT_ESCALATION_EMAIL="security@dashdental.space"

# Legal/release approvals. Keep false until the named review actually happened.
LEGAL_REVIEW_APPROVED="false"
DPA_APPROVED="false"
SUBPROCESSORS_APPROVED="false"
ORDER_FORM_APPROVED="false"
CANCELLATION_POLICY_APPROVED="false"
DATA_HANDLING_POLICY_APPROVED="false"
FIRST_CLINIC_REHEARSAL_APPROVED="false"

# Billing. Manual is the conservative launch mode; Stripe requires live keys.
BILLING_PROVIDER="manual"
MANUAL_BILLING_SUPPORT_EMAIL="support@dashdental.space"
MANUAL_BILLING_RECIPIENT_NAME=""
MANUAL_BILLING_RECIPIENT_ADDRESS=""
MANUAL_BILLING_IBAN=""
MANUAL_BILLING_SWIFT_BIC=""
MANUAL_BILLING_BANK_NAME=""
MANUAL_BILLING_BANK_ADDRESS=""
MANUAL_BILLING_CURRENCY="USD"
MANUAL_BILLING_INVOICE_PREFIX="DR"
MANUAL_BILLING_INSTRUCTIONS=""
MANUAL_INVOICE_TEMPLATE_APPROVED="false"

# Stripe self-serve billing. Required only when BILLING_PROVIDER=stripe|hybrid.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_SCALE=""

# Optional OAuth/OIDC login.
OAUTH_PROVIDER_LABEL=""
OAUTH_ISSUER_URL=""
OAUTH_AUTHORIZATION_URL=""
OAUTH_TOKEN_URL=""
OAUTH_USERINFO_URL=""
OAUTH_CLIENT_ID=""
OAUTH_CLIENT_SECRET=""
OAUTH_REDIRECT_URI="https://dashdental.space/api/v1/auth/oauth/callback"
OAUTH_SCOPES="openid email profile"
OAUTH_ALLOWED_EMAIL_DOMAINS=""

# Optional clinic database integration.
CLINIC_DATABASE_URL=""
CLINIC_DATABASE_SSL="false"

# Optional provider/version tuning.
META_GRAPH_API_VERSION="v23.0"
TENANT_OUTBOX_BACKPRESSURE_LIMIT="5000"
TENANT_OUTBOX_BACKPRESSURE_DELAY_MS="60000"
