DATABASE_URL="postgresql://dental:dental@localhost:5432/dental_recovery?schema=public"
# Production Neon example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=verify-full"
APP_STORAGE_DRIVER="auto"
REDIS_URL="redis://localhost:6379"
SESSION_SECRET="replace-with-a-long-random-session-signing-secret"
JWT_ACCESS_SECRET="replace-with-a-long-random-backend-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-backend-refresh-secret"
INTEGRATION_SECRET="replace-with-a-long-random-secret-for-encrypted-integration-credentials"
APP_URL="http://localhost:3000"
APP_PORT="4000"
BACKEND_INTERNAL_URL="http://localhost:4000/api/v1"
META_GRAPH_API_VERSION="v23.0"

# Live Telegram / WhatsApp / Instagram credentials are saved per clinic
# from the dashboard and encrypted with INTEGRATION_SECRET.
# APP_URL must point to a stable public HTTPS domain for webhooks.

# Optional OAuth/OIDC login. Users must already exist in Dash Dental and have
# an active organization membership with the same email returned by the provider.
OAUTH_PROVIDER_LABEL="Clinic SSO"
OAUTH_ISSUER_URL=""
OAUTH_AUTHORIZATION_URL=""
OAUTH_TOKEN_URL=""
OAUTH_USERINFO_URL=""
OAUTH_CLIENT_ID=""
OAUTH_CLIENT_SECRET=""
OAUTH_REDIRECT_URI="http://localhost:3000/api/v1/auth/oauth/callback"
OAUTH_SCOPES="openid email profile"
OAUTH_TOKEN_AUTH_METHOD="client_secret_post"
OAUTH_ALLOWED_EMAIL_DOMAINS=""
OAUTH_BOOTSTRAP_EMAILS=""
OAUTH_BOOTSTRAP_CLINIC_NAME="Clinic Workspace"
OAUTH_BOOTSTRAP_TIMEZONE="UTC"
OAUTH_BOOTSTRAP_ROLE="owner"
# Optional. Set this only if you need bootstrap users pinned to an existing org id.
OAUTH_DEFAULT_ORGANIZATION_ID=""
ENABLE_DEV_LOGIN="false"
ENABLE_DEMO_ACTIONS="false"
ENABLE_DEV_BILLING="false"

# Public auth abuse controls. Keep REQUIRE_* false until the Turnstile widget
# is wired for the target hostname, then enable it in staging before production.
REQUIRE_PUBLIC_AUTH_BOT_PROTECTION="false"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
EDGE_RATE_LIMIT_PROFILE="launch"
EDGE_PROTECTION_DEPLOYED="false"

# Go-live ownership and monitors. Set these in staging before running
# npm run go-live:check for a paid launch rehearsal.
SUPPORT_OWNER_NAME=""
SUPPORT_OWNER_EMAIL="support@dashdental.space"
SECURITY_CONTACT_EMAIL="security@dashdental.space"
INCIDENT_ESCALATION_EMAIL="incidents@dashdental.space"
SYNTHETIC_MONITOR_BASE_URL=""
SYNTHETIC_MONITOR_SCHEDULED="false"
PRODUCTION_MONITOR_POLICY_APPROVED="false"
LEGAL_REVIEW_APPROVED="false"
DPA_APPROVED="false"
SUBPROCESSORS_APPROVED="false"
ORDER_FORM_APPROVED="false"
CANCELLATION_POLICY_APPROVED="false"
DATA_HANDLING_POLICY_APPROVED="false"
FIRST_CLINIC_REHEARSAL_APPROVED="false"
DATABASE_BACKUPS_CONFIRMED="false"

# Billing provider. Use paddle for self-serve card checkout, manual for IBAN/SWIFT,
# or hybrid for Paddle/Stripe checkout plus manual fallback.
BILLING_PROVIDER="manual" # manual | paddle | stripe | hybrid

# Manual IBAN / SWIFT billing. These values are shown to clinic owners in
# /billing and returned after they request an invoice.
MANUAL_BILLING_RECIPIENT_NAME=""
MANUAL_BILLING_RECIPIENT_ADDRESS=""
MANUAL_BILLING_IBAN=""
MANUAL_BILLING_SWIFT_BIC=""
MANUAL_BILLING_BANK_NAME=""
MANUAL_BILLING_BANK_ADDRESS=""
MANUAL_BILLING_CORRESPONDENT_ACCOUNT=""
MANUAL_BILLING_CORRESPONDENT_BANK=""
MANUAL_BILLING_CORRESPONDENT_SWIFT_BIC=""
MANUAL_BILLING_INTERMEDIARY_ACCOUNT=""
MANUAL_BILLING_INTERMEDIARY_BANK=""
MANUAL_BILLING_INTERMEDIARY_SWIFT_BIC=""
MANUAL_BILLING_CURRENCY="USD"
MANUAL_BILLING_SUPPORT_EMAIL="support@dashdental.space"
MANUAL_BILLING_INVOICE_PREFIX="DR"
MANUAL_BILLING_INSTRUCTIONS="Send a bank transfer using the payment reference. Access is activated after payment confirmation."
MANUAL_INVOICE_TEMPLATE_APPROVED="false"

# Stripe Billing. Direct in-app plan changes are disabled unless
# ENABLE_DEV_BILLING=true; live billing should use Checkout and Portal.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_SCALE=""

# Paddle Billing. Use sandbox credentials locally; live credentials only in
# Vercel/production env. Webhook endpoint: /api/v1/webhooks/paddle.
PADDLE_ENV="sandbox" # sandbox | live
PADDLE_API_KEY=""
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_PRICE_STARTER_MONTHLY=""
PADDLE_PRICE_GROWTH_MONTHLY=""
PADDLE_PRICE_SCALE_MONTHLY=""
PADDLE_PRICE_STARTER_YEARLY=""
PADDLE_PRICE_GROWTH_YEARLY=""
PADDLE_PRICE_SCALE_YEARLY=""

# Optional legacy read-only connection to a clinic/PMS/CRM database.
# New clinics should save their own PostgreSQL URL in the dashboard.
# The database must expose a dental_recovery_leads view; see README.
CLINIC_DATABASE_URL=""
CLINIC_DATABASE_SSL="false"

# Runtime protection. Set limit to 0 only for controlled local debugging.
TENANT_OUTBOX_BACKPRESSURE_LIMIT="5000"
TENANT_OUTBOX_BACKPRESSURE_DELAY_MS="60000"

# Operational data lifecycle. These policies intentionally do not delete
# clinical conversations, leads, contacts, subscriptions, or audit logs.
OPERATIONAL_EVENT_RETENTION_DAYS="180"
BILLING_EVENT_RETENTION_DAYS="730"
REPLAY_ATTEMPT_RETENTION_DAYS="365"
INTEGRATION_EVENT_RETENTION_DAYS="365"
